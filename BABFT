		local CHEST_HOME = CFrame.new(-521.271667, -9.89999485, 172.898331, 0.855194747, -6.33011084e-08, 0.518306851, 1.27484903e-08, 1, 1.01095843e-07, -0.518306851, -7.98490021e-08, 0.855194747)

		local function getChest() local ok, c = pcall(function() return ws.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger end); return ok and c or nil end

		local function claim() local r = ws:FindFirstChild("ClaimRiverResultsGold"); if r then r:FireServer() end end

		local function swait(t) local e = os.clock() + t; while os.clock() < e and farm.on do task.wait(0.1) end end

		local function active(mode) return farm.on and farm.mode == mode end

		local function tp(pos, w) ensureFarmParts(); local r = root(); if r then r.CFrame = CFrame.new(pos) + Vector3.new(0, 2, 0); swait(w) end end



		local function cycleNormal() -- todos os stages + baú dourado no final

			swait(6)

			for i, key in ipairs(ORDER) do

				if not active("Normal") then return end

				tp(S[key], WAIT[i])

				if key == "W0" then

					local chest, r = getChest(), root()

					if chest and r then swait(1); chest.CFrame = r.CFrame; swait(1.3); chest.CFrame = CHEST_HOME; claim() end

				else claim() end

			end

			farm.runs = farm.runs + 1

		end

		local function cycleBlock() -- farm de gold block via baú

			swait(6); local chest = getChest(); if not chest then farm.on = false; return notify("Autofarm", "GoldenChest trigger not found.", 5) end

			chest.CFrame = CHEST_HOME; swait(3.25); if not active("Block") then return end

			ensureFarmParts(); local r = root(); if r then r.CFrame = CFrame.new(S.W0) + Vector3.new(0, 2, 0) end; swait(3); if not active("Block") then return end

			farm.runs = farm.runs + 1; r = root(); if r then chest.CFrame = r.CFrame end; swait(1); claim(); swait(9); chest.CFrame = CHEST_HOME

		end

		local function cycleReset() -- igual ao Normal, mas sem o baú: ao terminar, dá reset

			swait(6)

			for i, key in ipairs(ORDER) do

				if not active("Reset") then return end

				tp(S[key], WAIT[i]); claim()

			end

			if not active("Reset") then return end

			farm.runs = farm.runs + 1

			local old, h = lp.Character, hum(); if h then pcall(function() h.Health = 0 end) end

			local t0 = os.clock(); repeat task.wait(0.25) until not farm.on or (lp.Character and lp.Character ~= old and lp.Character:FindFirstChild("HumanoidRootPart")) or os.clock() - t0 > 20

			swait(1)

		end

		local function startFarm()

			if farm.loop then return end

			farm.on, farm.t0 = true, os.clock()

			farm.loop = task.spawn(function()

				while farm.on do

					local m = farm.mode

					local ok, err = pcall(function() if m == "Normal" then cycleNormal() elseif m == "Block" then cycleBlock() else cycleReset() end end)

					if not ok then notify("Autofarm", tostring(err), 5); task.wait(2) end

					task.wait()

				end

				farm.loop = nil

			end)

		end

		FarmSec:Dropdown({ Name = "farm mode", Flag = "sh_FarmMode", Items = { "Normal", "Block", "Reset" }, Default = "Normal", MaxSize = 70, Multi = false, Callback = function(v) local x = type(v) == "table" and v[1] or v; if x and x ~= "" then farm.mode = x end end })

		FarmSec:Toggle({ Name = "autofarm", Flag = "sh_FarmOn", Default = false, Callback = function(v)

			if v then startFarm(); notify("Autofarm", farm.mode .. " autofarm started.", 3)

			else farm.on = false; notify("Autofarm", "Stopped.", 3) end

		end })

		FarmSec:Label("Normal: stages + golden chest.", "Left"); FarmSec:Label("Block: gold block via chest.", "Left"); FarmSec:Label("Reset: same as Normal, but resets instead of using the chest.", "Left")

		local farmInfo = InfoLabel(StatSec, "Runs: 0 · Time: 00:00")

		PTG(StatSec, "anti-afk", "AntiAFK")

		local mapStuff = { "Blocks", "Challenge", "TempStuff", "MainTerrain", "OtherStages", "Sand", "Water", "WaterMask" }

		local function setHideMap(hide)

			local rs = game:GetService("ReplicatedStorage")

			if hide then

				for _, v in ipairs(mapStuff) do

					local obj = ws:FindFirstChild(v) or (ws:FindFirstChild("BoatStages") and ws.BoatStages:FindFirstChild(v))

					if obj then obj.Parent = rs end

				end

			else

				for _, v in ipairs(mapStuff) do

					local obj = rs:FindFirstChild(v)

					if obj then

						if v == "OtherStages" and ws:FindFirstChild("BoatStages") then

							obj.Parent = ws.BoatStages

						else

							obj.Parent = ws

						end

					end

				end

			end

		end

		PTG(StatSec, "delete map (fps boost)", "HideMap", function(on)

			pcall(setHideMap, on)

		end)

		conns[#conns + 1] = lp.Idled:Connect(function() if P.AntiAFK then pcall(function() VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()) end) end end)

		task.spawn(function()

			while running do

				task.wait(1)

				if farm.on then local t = floor(os.clock() - farm.t0); farmInfo:Set(string.format("Runs: %d · Time: %02d:%02d · Mode: %s", farm.runs, floor(t / 60), t % 60, farm.mode)) end

			end

		end)



		local origUnload = Library.Unload

		Library.Unload = function(self, ...)

			running, farm.on = false, false

			if P.HideMap then pcall(setHideMap, false) end

			pcall(function() if farmPartsFolder then farmPartsFolder:Destroy() end end)

			for k in pairs(P) do if type(P[k]) == "boolean" then P[k] = false end end

			pcall(dropFly); for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end; conns = {}

			pcall(function() ws.Gravity = defGrav; local h = hum(); if h then h.WalkSpeed, h.JumpPower = 16, 50 end end)

			return origUnload(self, ...)

		end

	end



