local function getPlayerDetails(plr)

	if not plr then return nil end

	-- 1) Settings > BlockRequests

	local blockReq = nil

	pcall(function()

		local s = plr:FindFirstChild("Settings")

		if s then

			local br = s:FindFirstChild("BlockRequests")

			if br and br.Value ~= nil then blockReq = br.Value

			elseif s:GetAttribute("BlockRequests") ~= nil then blockReq = s:GetAttribute("BlockRequests") end

		end

	end)

	-- 2) Data > AgeChecked (or Attribute / Property)

	local ageVal = nil

	pcall(function()

		local d = plr:FindFirstChild("Data")

		if d and d:FindFirstChild("AgeChecked") then ageVal = d.AgeChecked.Value end

		if ageVal == nil and plr:FindFirstChild("AgeChecked") then ageVal = plr.AgeChecked.Value end

		if ageVal == nil then ageVal = plr:GetAttribute("AgeChecked") end

		if ageVal == nil and d then ageVal = d:GetAttribute("AgeChecked") end

		if ageVal == nil then

			local okP, prop = pcall(function() return plr.AgeChecked end)

			if okP then ageVal = prop end

		end

	end)

	local isAgeVerified = (tostring(ageVal) == "Checked") or (ageVal == true)

	-- 3) Whitelisted Tools (Backpack + Character if equipped)

	local tools, seen = {}, {}

	local function scan(parent)

		if not parent then return end

		for _, item in ipairs(parent:GetChildren()) do

			if isWhitelistedTool(item) and not seen[item.Name] then

				seen[item.Name] = true

				tools[#tools + 1] = { name = item.Name, icon = getToolTexture(item) }

			end

		end

	end

	scan(plr:FindFirstChild("Backpack"))

	scan(plr.Character)

	table.sort(tools, function(a, b) return a.name < b.name end)

	return {

		player = plr,

		displayName = plr.DisplayName,

		username = plr.Name,

		userId = plr.UserId,

		team = plr.Team and plr.Team.Name or "No Team",

		teamColor = plr.TeamColor and plr.TeamColor.Color or Color3.fromRGB(160, 160, 160),

		blockRequests = blockReq,

		ageVerified = isAgeVerified,

		ageRaw = tostring(ageVal or "Unchecked"),

		tools = tools,

	}

end

