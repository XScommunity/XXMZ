		local ok, res, err = pcall(IMG.png, bytes); if ok and res then return res end; decErr = ok and err or tostring(res)

	elseif b1 == 0xFF and b2 == 0xD8 then

		local ok, res, err = pcall(IMG.jpg, bytes); if ok and res then return res end; decErr = ok and err or tostring(res)

	elseif sub(bytes, 1, 2) == "BM" then

