		pcall(function()

			local d = tool:FindFirstChild("Data")

			if d and d:FindFirstChild("TextureId") then tex = d.TextureId.Value end

		end)

	end

	if (not tex or tex == "") then

		pcall(function() tex = tool:GetAttribute("TextureId") or "" end)

	end

