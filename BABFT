	-- "My Team" é resolvido na hora de salvar (funciona mesmo se você trocar de time)

	local function resolveTeam(label)

		if not label or label == MY then return lp.Team end

		return Teams:FindFirstChild(label)

	end

	local function zoneOf(team)

		local z = team and ws:FindFirstChild(team.TeamColor.Name .. "Zone")

		if not z then return nil end

		return z:IsA("BasePart") and z.CFrame or z:GetPivot()

	end

	local function collectBlocks(team)

		local out, root = {}, ws:FindFirstChild("Blocks")

		if not root then return out end

		for _, plr in ipairs(Players:GetPlayers()) do

			if plr.Team == team then

				local folder = root:FindFirstChild(plr.Name)

				if folder then

					for _, b in ipairs(folder:GetChildren()) do

						if b:FindFirstChild("PPart") then out[#out + 1] = b end

					end

				end

			end

		end

		return out

	end



	local function r5(x) return floor(x * 100000 + 0.5) / 100000 end

