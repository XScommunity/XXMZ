		line = trim(line); local tag = line:match("^(%S+)")

		if tag == "v" then

			local x, y, z, r, g, b = line:match("^v%s+(%S+)%s+(%S+)%s+(%S+)%s*(%S*)%s*(%S*)%s*(%S*)"); x, y, z = tonumber(x), tonumber(y), tonumber(z); if x and y and z then verts[#verts + 1] = Vector3.new(x, y, z); r, g, b = tonumber(r), tonumber(g), tonumber(b); if r and g and b then vCols[#verts] = Color3.new(clamp(r, 0, 1), clamp(g, 0, 1), clamp(b, 0, 1)) end end

		elseif tag == "o" or tag == "g" then

