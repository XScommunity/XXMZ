		elseif tag == "f" then local idx = {}; for tok in line:sub(2):gmatch("%S+") do local vi = tonumber(tok:match("^(-?%d+)")); if vi then idx[#idx + 1] = vi < 0 and (#verts + 1 + vi) or vi end end; if #idx >= 2 then polys[#polys + 1] = { idx = idx, mat = curMat, obj = curObj } end end

