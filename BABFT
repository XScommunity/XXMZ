	CSec:Button({ Name = "refresh", Callback = function() Library:RefreshConfigsList(cDrop) end }); Library:RefreshConfigsList(cDrop); MSec:Label("menu keybind", "Left"):Keybind({ Name = "MenuKeybind", Flag = "MenuKeybind", Mode = "toggle", Default = Library.MenuKeybind, Callback = function() Library.MenuKeybind = Library.Flags["MenuKeybind"].Key end }); MSec:Toggle({ Name = "watermark", Flag = "sh_Watermark", Default = true, Callback = function(v) if Watermark then Watermark:SetVisibility(v and true or false) end end }); MSec:Button({ Name = "unload", Callback = function() Library:Unload() end })

