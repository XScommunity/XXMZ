	local Sub = Pages.Settings:SubPage({ Name = "configs & menu", Icon = "96491224522405", Columns = 2 }); local CSec = Sub:Section({ Name = "profiles", Icon = "96491224522405", Side = 1 }); local MSec = Sub:Section({ Name = "menu", Icon = "93007870315593", Side = 2 }); local selCfg, nameCfg; local cDrop = CSec:Dropdown({ Name = "configs", Flag = "ConfigsList", Items = {}, Multi = false, Callback = function(v) selCfg = v end })

